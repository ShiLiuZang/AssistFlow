# 仓库内统一使用 LF 换行，避免 Windows 编辑器把整份文件改成 CRLF
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.sqlite binary
*.db binary
*.onnx binary
*.pt binary
*.bin binary
*.safetensors binary
