# Copy this file to .env and replace the placeholders. Never commit .env.

# Chat model
CHAT_MODEL=your-chat-model
CHAT_BASE_URL=https://example.com/v1
CHAT_API_KEY=replace-with-chat-api-key
CHAT_THINKING=disabled

# Embedding and reranking
EMBED_MODEL=your-embedding-model
EMBED_BASE_URL=https://example.com/v1
EMBED_API_KEY=replace-with-embedding-api-key
RERANK_BASE_URL=https://example.com/v1
RERANK_MODEL=your-reranker-model
RERANK_API_STYLE=auto
RERANK_API_KEY=replace-with-rerank-api-key

# MySQL, Milvus, and graph checkpoints
HANDWRITTEN_DATABASE_URL=mysql+asyncmy://username:password@127.0.0.1:3308/minihelp_handwritten
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=minihelp_handwritten_knowledge
GRAPH_CHECKPOINT_PATH=data/graph-checkpoints.sqlite

# Retrieval
RECALL_TOP_K=50
RERANK_TOP_K=10
RERANK_MIN_SCORE=0.3
EVIDENCE_MIN_CONFIDENCE=0.5
SUBQUERY_SPLIT=true

# Optional MCP services
MCP_LOGISTICS_URL=
MCP_AFTERSALES_URL=

# Optional Langfuse service
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Name recorded on local reviews
REVIEW_ADMIN_NAME=local-reviewer

# The old CHECKPOINTER_DB_PATH, TEST_DATABASE_URL, and TOKEN_BUDGET
# entries in some local .env files are not read by app/config.py.
