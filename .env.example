


CHAT_MODEL=your-chat-model
CHAT_BASE_URL=https://example.com/v1
CHAT_API_KEY=replace-with-chat-api-key
CHAT_THINKING=disabled


EMBED_MODEL=your-embedding-model
EMBED_BASE_URL=https://example.com/v1
EMBED_API_KEY=replace-with-embedding-api-key
RERANK_BASE_URL=https://example.com/v1
RERANK_MODEL=your-reranker-model
RERANK_API_STYLE=auto
RERANK_API_KEY=replace-with-rerank-api-key


HANDWRITTEN_DATABASE_URL=mysql+asyncmy://username:password@127.0.0.1:3308/minihelp_complete
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=minihelp_handwritten_knowledge
GRAPH_CHECKPOINT_PATH=data/graph-checkpoints.sqlite


RECALL_TOP_K=50
RERANK_TOP_K=10
RERANK_MIN_SCORE=0.3
EVIDENCE_MIN_CONFIDENCE=0.5
SUBQUERY_SPLIT=true


MCP_LOGISTICS_URL=
MCP_AFTERSALES_URL=


LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=


# 认证：生产环境两个密钥都必须配置且不少于 32 字符，可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
# 本地开发可只设 AUTH_DEV_MODE=true（自动生成临时密钥，并开放模拟顾客入口）
AUTH_SECRET=
CUSTOMER_TOKEN_SECRET=
AUTH_DEV_MODE=true
STAFF_TOKEN_TTL_MINUTES=480

# 限流（每分钟次数）
RATE_CHAT_PER_MINUTE=20
RATE_LOGIN_PER_MINUTE=10       # 同一 IP 下每个账号
RATE_LOGIN_IP_PER_MINUTE=60    # 每个 IP 总次数
RATE_STAFF_MODEL_PER_MINUTE=30

# 模型超时
CHAT_TIMEOUT_SECONDS=20
CHAT_MAX_RETRIES=1
CHAT_TURN_TIMEOUT_SECONDS=60

# 拼多多渠道（见 docs/phase3-pinduoduo-channel.md）：消息经渠道桥收发
PDD_ENABLED=false
PDD_BRIDGE_SECRET=
PDD_BRIDGE_SEND_URL=
# 开放平台应用与店铺授权（查订单状态，可选）
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ACCESS_TOKEN=
PDD_MAX_MESSAGE_CHARS=500
CHANNEL_MERGE_SECONDS=1.5
CHANNEL_MERGE_MAX_SECONDS=6
CHANNEL_HOLD_SECONDS=8
CHANNEL_IDLE_MINUTES=1440

# 回复时延（见 docs/latency.md）
SPECULATIVE_RETRIEVE=true
SPECULATIVE_ANSWER=true
INTENT_RULES=true
